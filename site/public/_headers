# Cabeceras HTTP de seguridad y caché.
# Este formato lo entienden Netlify y Cloudflare Pages. En nginx/Apache hay que traducirlo
# (ver web/site/README.md). La CSP principal va en un <meta> de cada página (la genera Astro con
# los hashes de sus scripts); aquí se añade lo que un <meta> no puede hacer.

/*
  # Nadie puede meter la web en un iframe (clickjacking). frame-ancestors solo funciona como cabecera.
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  # Solo HTTPS durante un año (activar cuando el dominio tenga HTTPS funcionando)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # La web no usa cámara, micro, ubicación ni pagos en la propia página (Stripe Checkout va en su dominio)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Archivos con hash en el nombre (CSS, JS, imágenes, fuentes): nunca cambian, caché de un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
