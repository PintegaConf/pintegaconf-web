---
// Redes de una persona (ponente u organización): enlaces normales con icono y nombre visible, que no
// cargan nada de la red hasta que se pulsan. Los usan VentanaPersona.astro y la info del equipo en móvil.
import { iconosRedes, type NombreRed } from "../data/iconos-redes";

interface Props {
  nombre: string;
  redes?: { nombre: NombreRed; url: string }[];
}
const { nombre, redes = [] } = Astro.props;
---
{redes.length > 0 && (
  <ul class="redes" aria-label={`${nombre} en redes`}>
    {redes.map((r) => (
      <li>
        <a href={r.url} rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={iconosRedes[r.nombre]} />
          <span>{r.nombre}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .redes { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  a {
    display: inline-flex; align-items: center; gap: .45rem; min-height: 36px; padding: .35rem .9rem .35rem .7rem;
    border-radius: 999px; border: 1.5px solid var(--gold); color: var(--accent-text);
    font: 600 14px/1.2 var(--f-sans); text-decoration: none; transition: background .2s, color .2s;
  }
  a:hover { background: var(--gold); color: var(--ink); }
  svg { flex: none; }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
