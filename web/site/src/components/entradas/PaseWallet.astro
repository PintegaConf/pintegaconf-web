---
// Entrada estilo Apple Wallet: vista previa de la entrada con el nombre del formulario en vivo,
// inclinación 3D con el ratón (scripts/entradas/pase.ts) y QR decorativo "Muy pronto".
import { Image } from "astro:assets";
import logo from "../../assets/marca/logo-horizontal.svg";
import orbe from "../../assets/marca/orbe.png";
import huellas from "../../assets/marca/huellas.svg";
import { evento } from "../../data/evento";
import QrDecorativo from "./QrDecorativo.astro";
---
<div class="pass-stage">
  <article class="pass" aria-label={`Vista previa de tu entrada de ${evento.nombre}`}>
    <header class="pass-head">
      <Image class="pass-logo" src={logo} alt={evento.nombre} />
      <div><span class="pass-label">Charlas</span><span class="pass-value">Sáb 10 abr</span></div>
    </header>
    <div class="pass-strip">
      <Image class="steps" src={huellas} alt="" />
      <Image class="orb" src={orbe} alt="" width={300} widths={[150, 300]} sizes="150px" />
      <span class="pass-label">Evento</span>
      <p class="pass-title">Píntega Conf&nbsp;’27</p>
      <p class="pass-tag">{evento.lema}</p>
    </div>
    <div class="pass-fields">
      <div><span class="pass-label">Asistente</span><span class="pass-value" data-pase-nombre>Tu nombre aquí</span></div>
      <div class="right"><span class="pass-label">Entrada</span><span class="pass-value">General</span></div>
      <div><span class="pass-label">Lugar</span><span class="pass-value">{evento.charlas.lugar}</span></div>
      <div class="right"><span class="pass-label">Pre-evento</span><span class="pass-value">Vie 9 abr</span></div>
    </div>
    <div class="pass-tear" aria-hidden="true"><span></span></div>
    <div class="pass-code">
      <div class="qr" aria-hidden="true"><QrDecorativo /><b>Muy pronto</b></div>
      <small>Tu código QR llegará al comprar la entrada</small>
    </div>
  </article>
</div>

<style>
  .pass-stage { display: grid; place-items: center; perspective: 1100px; padding: .5rem 0; }
  .pass {
    --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 30%;
    position: relative; width: 360px; max-width: 100%; border-radius: 22px; overflow: hidden;
    background: var(--gold); color: var(--ink); font-family: var(--f-sans);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .65), 0 10px 22px -12px rgba(0, 0, 0, .5);
    transform: rotateX(var(--rx)) rotateY(var(--ry));   /* sin preserve-3d: hacía que el recorte no contase y daba scroll horizontal */
    transition: transform .5s var(--ease);
  }
  .pass:global(.is-tilting) { transition: transform .08s linear; }
  .pass::after {   /* brillo que sigue al puntero */
    content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background: radial-gradient(circle at var(--mx) var(--my), rgba(255, 255, 255, .38), rgba(255, 255, 255, 0) 45%);
    mix-blend-mode: soft-light; opacity: 0; transition: opacity .3s;
  }
  .pass:global(.is-tilting)::after { opacity: 1; }

  .pass-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; padding: 1.1rem 1.25rem .9rem; }
  .pass-logo { width: 150px; height: auto; }
  /* Alto contraste (colores forzados): el logo es negro y el fondo pasa a negro; placa blanca para que se vea */
  @media (forced-colors: active) {
    .pass-logo { background: #fff; padding: 3px 6px; border-radius: 4px; forced-color-adjust: none; }
  }
  .pass-label { display: block; font: 700 9.5px/1.2 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; opacity: .8; margin-bottom: .2rem; }   /* .8: 6,6:1 sobre dorado (con .62 era 4,0:1, insuficiente para texto pequeño) */
  .pass-value { display: block; font: 700 17px/1.15 var(--f-head); overflow-wrap: anywhere; }
  .pass-head .pass-value { font-size: 19px; text-align: right; }
  .pass-head .pass-label { text-align: right; }

  .pass-strip { position: relative; overflow: hidden; background: var(--ink); color: var(--white); padding: 1.3rem 1.25rem 1.35rem; min-height: 124px; }
  .orb { position: absolute; right: -34px; top: -14px; width: 150px; height: auto; opacity: .95; transform: rotate(-8deg); }
  .steps { position: absolute; left: -30px; bottom: -8px; width: 300px; height: auto; max-width: none; opacity: .1; filter: invert(1); transform: rotate(-4deg); }
  .pass-strip .pass-label { color: var(--gold); opacity: .85; position: relative; }
  .pass-title { position: relative; margin: 0; font: 700 29px/1.02 var(--f-head); color: var(--gold); max-width: 11ch; }
  .pass-tag { position: relative; margin: .45rem 0 0; font: 400 11px/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: #d6d6d6; }

  .pass-fields { display: grid; grid-template-columns: 1.25fr 1fr; gap: .95rem 1rem; padding: 1.1rem 1.25rem 1.15rem; }
  .right { text-align: right; }

  /* Línea troquelada con muescas: círculos del color del fondo (sin máscaras CSS, por Safari) */
  .pass-tear { position: relative; height: 26px; }
  .pass-tear::before, .pass-tear::after { content: ""; position: absolute; top: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--bg); }
  .pass-tear::before { left: -13px; }
  .pass-tear::after { right: -13px; }
  .pass-tear span { position: absolute; left: 22px; right: 22px; top: 12px; border-top: 2px dashed rgba(28, 28, 27, .35); }

  .pass-code { display: grid; justify-items: center; gap: .6rem; padding: .7rem 1.25rem 1.35rem; }
  .qr { position: relative; width: 132px; height: 132px; padding: 10px; background: #fff; border-radius: 12px; }
  .qr :global(svg) { width: 100%; height: 100%; filter: blur(2.4px); opacity: .55; }
  .qr b {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); white-space: nowrap;
    background: var(--ink); color: var(--gold); border-radius: 999px; padding: .38rem .75rem;
    font: 700 10px/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase;
  }
  .pass-code small { font: 400 11px/1.3 var(--f-mono); letter-spacing: .04em; opacity: .7; text-align: center; }

  @media (max-width: 680px) {
    .pass { width: 100%; max-width: 340px; }
    .pass-title { font-size: 26px; }
    .orb { width: 130px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pass, .pass:global(.is-tilting) { transition: none; transform: none; }
    .pass::after { display: none; }
  }
</style>
