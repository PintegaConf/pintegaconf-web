---
// Las tres entradas (data/entradas.ts) como entradas de papel: 1, 2 y 3 llamitas del logo (cuanto más fuego, más
// incluye). El talón negro es el enlace a Weezevent con esa tarifa ya elegida. Muescas: círculos del color del fondo,
// no máscaras (Safari). Al pasar el ratón la entrada se endereza y sube.
// Con una sola columna (≤ 980 px) cada entrada es un desplegable (<details>) cerrado: se ven las tres de un vistazo
// (nombre, precio y lo que la distingue) y al abrirla salen lo que incluye y el talón. scripts/entradas/selector.ts
// las cierra en una columna y las deja fijas en escritorio; sin JS, todas abiertas.
import { entradas } from "../../data/entradas";
---
<svg class="defs" aria-hidden="true" focusable="false">
  <!-- La llamita del logo en un solo trazado: el hueco de dentro (evenodd) deja ver el papel, como el recorte del logo -->
  <symbol id="llama-entrada" viewBox="456 247.5 16.9 35.3">
    <path fill="currentColor" fill-rule="evenodd" d="M 464.292969 282.441406 C 462.039062 282.214844 460.023438 280.992188 458.566406 279.257812 C 456.703125 277.03125 455.167969 273.496094 457.902344 267.632812 C 458.878906 265.539062 460.214844 263.632812 461.78125 261.9375 C 467.097656 256.183594 469.460938 255.285156 467.496094 247.8125 C 467.496094 247.8125 470.539062 250.695312 472.011719 255.394531 C 473.167969 259.085938 472.761719 263.089844 471.0625 266.566406 C 470.082031 268.574219 469.734375 269.585938 470.667969 270.882812 C 474.433594 276.113281 470.789062 283.097656 464.292969 282.441406 Z M 464.757812 277.902344 C 463.253906 277.964844 461.894531 277.027344 461.242188 275.671875 C 460.28125 273.667969 459.605469 270.03125 463.527344 265.546875 C 469.585938 258.625 469.585938 256.609375 469.585938 256.609375 C 469.585938 256.609375 471.027344 261.796875 467.566406 266.410156 C 467.566406 266.410156 465.546875 269.871094 467.277344 271.890625 C 468.707031 273.554688 467.972656 277.773438 464.757812 277.902344 Z"/>
  </symbol>
</svg>
<!-- role="list": Safari quita la semántica de lista cuando no hay viñetas -->
<ul class="tarifas" role="list">
  {entradas.map((e, i) => (
    <li>
      <details class="tarifa" open>
        <summary class="tarifa-cabecera">
          <span class="llamas" aria-hidden="true">
            {Array.from({ length: i + 1 }, () => <svg viewBox="0 0 16.9 35.3"><use href="#llama-entrada" /></svg>)}
          </span>
          <h3 class="tarifa-nombre">{e.nombre}</h3>
          <span class="precio">{e.precio}&nbsp;€ <small>IVA incluido</small></span>
          <span class="resumen">{e.resumen}</span>
          <svg class="flecha-abrir" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <ul class="incluye" role="list">
          {e.incluye.map((x) => (
            <li class={x.incluido ? undefined : "no"}>
              {x.incluido
                ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                : <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>}
              <span>{x.texto}</span>
            </li>
          ))}
        </ul>
        <a class="tarifa-talon" href={e.tienda}>
          Comprar {e.nombre}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </details>
    </li>
  ))}
</ul>

<script>
  import "../../scripts/entradas/selector";
</script>

<style>
  .defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .tarifas { list-style: none; margin: 0 0 5rem; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 330px)); gap: 2.5rem; justify-content: center; }
  .tarifas > li { transform: rotate(-1.2deg); transition: transform .2s var(--ease); }
  .tarifas > li:nth-child(2) { transform: rotate(.8deg); }
  .tarifas > li:nth-child(3) { transform: rotate(-.5deg); }
  .tarifas > li:hover, .tarifas > li:focus-within { transform: translateY(-6px); }
  .tarifa { background: var(--gold); color: var(--ink); }

  /* Cabecera (<summary>): en escritorio, llamitas, nombre y precio en columna; no despliega nada */
  .tarifa-cabecera { display: grid; grid-template-areas: "llamas" "nombre" "precio"; padding: 1.6rem 1.6rem 1.2rem; list-style: none; cursor: default; }
  .tarifa-cabecera::-webkit-details-marker { display: none; }
  .llamas { grid-area: llamas; display: flex; gap: .35rem; margin-bottom: .9rem; }
  .llamas svg { width: 17px; height: 36px; }
  .tarifa-nombre { grid-area: nombre; margin: 0; font: 700 30px/1.1 var(--f-head); }
  .precio { grid-area: precio; margin-top: .25rem; font: 700 56px/1 var(--f-head); }
  .precio small { display: block; margin-top: .4rem; font: 700 11px/1.3 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; }
  .resumen, .flecha-abrir { display: none; }

  /* Hueco para cuatro líneas (las de Hoguera): así los talones de las tres quedan a la misma altura */
  .incluye { list-style: none; margin: 0; padding: 0 1.6rem 1.5rem; min-height: calc(4 * 22px + 3 * .55rem + 1.5rem); display: grid; align-content: start; gap: .55rem; font: 600 16px/1.3 var(--f-sans); }
  .incluye li { display: flex; align-items: center; gap: .6rem; }
  .incluye svg { flex: none; width: 22px; height: 22px; padding: 3px; border-radius: 50%; background: var(--ink); color: var(--gold); }
  .incluye .no svg { background: none; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }

  /* Talón: el enlace. Borde dorado (en el tema oscuro, el negro no se distingue del fondo), línea de corte y muescas
     del color de la sección */
  .tarifa-talon {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    padding: 1.1rem 1.6rem; background: var(--ink); color: var(--gold); border: 2px solid var(--gold); border-top-style: dashed;
    font: 700 21px/1.1 var(--f-head); text-decoration: none;
  }
  .tarifa-talon::before, .tarifa-talon::after { content: ""; position: absolute; top: -12px; width: 20px; height: 20px; border-radius: 50%; background: var(--bg); }
  .tarifa-talon::before { left: -12px; }
  .tarifa-talon::after { right: -12px; }
  .tarifa-talon svg { flex: none; width: 22px; height: 22px; transition: transform .2s var(--ease); }
  .tarifa-talon:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tarifa-talon:hover svg { transform: translateX(4px); }

  @media (forced-colors: active) {
    .tarifa { border: 2px solid CanvasText; }
    .tarifa-talon { border-color: CanvasText; }
  }
  @media (prefers-reduced-motion: reduce) { .tarifas > li, .tarifa-talon svg, .flecha-abrir { transition: none; } }
  @media (max-width: 1240px) { .tarifas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; } }

  /* Una columna: desplegables. Cerrado, una fila compacta con lo que distingue a cada entrada; abierto, la entrada entera */
  @media (max-width: 980px) {
    .tarifas { grid-template-columns: 1fr; gap: 1.25rem; max-width: 440px; margin-inline: auto; }
    .tarifas > li:hover, .tarifas > li:focus-within { transform: none; }
    .tarifa-cabecera {
      grid-template-columns: 1fr auto auto; grid-template-areas: "llamas precio flecha" "nombre precio flecha" "resumen precio flecha";
      column-gap: .9rem; align-items: center; padding: 1rem 1.2rem; cursor: pointer;
    }
    .llamas { margin-bottom: .35rem; gap: .25rem; }
    .llamas svg { width: 12px; height: 25px; }
    .tarifa-nombre { font-size: 26px; }
    .precio { margin: 0; font-size: 36px; text-align: right; }
    .precio small { font-size: 10px; letter-spacing: .08em; }
    .resumen { display: block; grid-area: resumen; margin-top: .15rem; font: 600 15px/1.3 var(--f-sans); }
    .flecha-abrir {
      display: block; grid-area: flecha; width: 30px; height: 30px; padding: 4px; border-radius: 50%;
      background: var(--ink); color: var(--gold); transition: transform .2s var(--ease);
    }
    .tarifa[open] .flecha-abrir { transform: rotate(180deg); }
    .incluye { min-height: 0; padding: .2rem 1.2rem 1.2rem; }
    .tarifa-talon { padding: 1rem 1.2rem; }
  }
  @media (max-width: 680px) { .tarifas { margin-bottom: 3.5rem; } }
</style>
