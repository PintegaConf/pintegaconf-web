---
// Fondo de la sección EQUIPO: el orbe dorado de la portada con una corona de llamas (la llamita del
// logo) que salen de él como rayos de sol y giran despacio. Basado en la propuesta
// web_assets/orbes/orbe-corona.svg.
//
// Es decorativo (aria-hidden). El giro dura más de 5 s, así que se puede pausar con el botón de la
// sección (clase .orbe-pausado en #equipo, WCAG 2.2.2); con «reducir movimiento» no gira.
const LLAMAS = 16;
const RADIO_DISCO = 137;
const RADIO_BASE = 131;       // las llamas nacen un poco por dentro del borde del disco
const LLAMA = { ancho: 40.2, alto: 84 };
const angulos = Array.from({ length: LLAMAS }, (_, i) => (360 / LLAMAS) * i);
---
<svg class="orbe" viewBox="-220 -220 440 440" aria-hidden="true" focusable="false">
  <defs>
    <!-- La llamita del logo: contorno dorado + interior del color del fondo (recorte, como en el logo).
         Los colores llegan por herencia desde cada <use> (color → contorno, fill → interior): las reglas
         de la hoja no siempre alcanzan al clon de <use>, y la CSP no deja usar style en línea. -->
    <symbol id="orbe-llama" viewBox="456.0 247.5 16.9 35.3">
      <path fill="currentColor" d="M 464.292969 282.441406 C 462.039062 282.214844 460.023438 280.992188 458.566406 279.257812 C 456.703125 277.03125 455.167969 273.496094 457.902344 267.632812 C 458.878906 265.539062 460.214844 263.632812 461.78125 261.9375 C 467.097656 256.183594 469.460938 255.285156 467.496094 247.8125 C 467.496094 247.8125 470.539062 250.695312 472.011719 255.394531 C 473.167969 259.085938 472.761719 263.089844 471.0625 266.566406 C 470.082031 268.574219 469.734375 269.585938 470.667969 270.882812 C 474.433594 276.113281 470.789062 283.097656 464.292969 282.441406"/>
      <path d="M 464.757812 277.902344 C 463.253906 277.964844 461.894531 277.027344 461.242188 275.671875 C 460.28125 273.667969 459.605469 270.03125 463.527344 265.546875 C 469.585938 258.625 469.585938 256.609375 469.585938 256.609375 C 469.585938 256.609375 471.027344 261.796875 467.566406 266.410156 C 467.566406 266.410156 465.546875 269.871094 467.277344 271.890625 C 468.707031 273.554688 467.972656 277.773438 464.757812 277.902344"/>
    </symbol>
  </defs>
  <g class="orbe-corona">
    {angulos.map((a) => (
      <use href="#orbe-llama" x={-LLAMA.ancho / 2} y={-RADIO_BASE - LLAMA.alto} width={LLAMA.ancho} height={LLAMA.alto} transform={`rotate(${a})`} />
    ))}
  </g>
  <circle class="orbe-disco" r={RADIO_DISCO} />
</svg>

<style>
  .orbe { display: block; overflow: visible; }
  .orbe-corona use { color: var(--gold); fill: var(--equipo-fondo); }
  .orbe-disco { fill: var(--gold); }

  /* Giro lento. El grupo gira alrededor del centro del disco (0,0 del viewBox). */
  .orbe-corona { transform-origin: 0 0; animation: orbe-girar 90s linear infinite; }
  @keyframes orbe-girar { to { transform: rotate(360deg); } }
  :global(#equipo.orbe-pausado) .orbe-corona { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .orbe-corona { animation: none; }
  }
</style>
