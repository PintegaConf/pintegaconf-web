---
// Menú desplegable (panel dorado a la derecha). Se abre con la hamburguesa de la cabecera.
import { secciones, enlaceEntradas } from "../../data/navegacion";
const enlaces = [...secciones, enlaceEntradas];
---
<nav class="menu" id="menu" aria-label="Secciones" inert>
  <button class="menu-close" type="button" aria-label="Cerrar menú">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path></svg>
  </button>
  <ul>
    {enlaces.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}
    <li><button class="menu-theme" type="button" data-tema-boton data-tema-texto>Modo claro</button></li>
  </ul>
</nav>

<script>
  import "../../scripts/menu";
</script>

<style>
  .menu {
    position: fixed; top: calc(var(--bar-h) + 10px); right: 0; z-index: 200;
    width: 300px; padding: 2rem 2.5rem 1.6rem;
    background: var(--gold); color: var(--ink);
    border-radius: 36px 0 0 36px; box-shadow: 0 6px 0 rgba(0, 0, 0, .25);
    transform: translateX(105%);
    transition: transform .45s var(--ease);
  }
  /* Cerrado queda fuera de pantalla e `inert` (sin foco ni lector de pantalla); lo quita scripts/menu.ts */
  .menu.open { transform: none; }
  ul { list-style: none; margin: 0; padding: 0; text-align: center; }
  li + li::before { content: ""; display: block; width: 110px; height: 3px; background: var(--ink); margin: .55rem auto; }
  a, .menu-theme { font: 700 1.15rem var(--f-head); text-decoration: none; color: inherit; }
  .menu-theme { background: none; border: 0; padding: 0; cursor: pointer; }
  a:hover, .menu-theme:hover { text-decoration: underline; text-underline-offset: 4px; }
  .menu-close {
    position: absolute; top: 14px; left: -14px; width: 38px; height: 38px; border-radius: 50%;
    border: 2px solid var(--ink); background: var(--white); color: var(--ink); cursor: pointer;
    display: grid; place-items: center; padding: 0;
  }
  @media (max-width: 680px) {
    .menu { width: min(300px, 86vw); }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu { transition: none; }
  }
</style>
