---
// Enlaces a las redes de Píntega Conf (pie). Son enlaces normales, no widgets: no cargan nada de
// LinkedIn, Instagram ni X hasta que se pulsan (ni cookies ni rastreo, ver /seguridad/).
// Icono + nombre visible: el nombre accesible es el mismo texto que se ve (WCAG 2.5.3).
// Se abren en la misma pestaña, como cualquier otro enlace (sin cambios de contexto inesperados).
import { evento } from "../../data/evento";
import { iconosRedes } from "../../data/iconos-redes";
---
<ul class="redes" aria-label="Píntega Conf en redes sociales">
  {evento.redes.map((r) => (
    <li>
      <a href={r.url} rel="me noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={iconosRedes[r.nombre]} />
        <span>{r.nombre}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .redes { list-style: none; margin: 0 0 .6rem; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  a {
    display: inline-flex; align-items: center; gap: .45rem; min-height: 32px; padding: .3rem .85rem .3rem .65rem;
    border-radius: 999px; border: 1.5px solid var(--ink); color: var(--ink);
    font: 600 14px/1.2 var(--f-sans); text-decoration: none; transition: background .2s, color .2s;
  }
  a:hover { background: var(--ink); color: var(--gold); }
  svg { flex: none; }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
